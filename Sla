<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sangue e Medo — Ficha de Personagem</title>
<style>
:root{--bg:#11100f;--panel:#1c1a18;--panel2:#24211e;--line:#51463d;--text:#eee7dc;--muted:#b5a99b;--red:#9d302d;--gold:#b18a52;--green:#627b5a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#29211d 0,#11100f 55%);color:var(--text);font:15px/1.45 Georgia,serif}
header{padding:30px 18px 22px;text-align:center;border-bottom:1px solid var(--line);background:linear-gradient(#1b1715dd,#11100f)}
header .sig{color:var(--red);font-size:12px;letter-spacing:5px;text-transform:uppercase}h1{font-size:clamp(28px,5vw,44px);letter-spacing:3px;margin:5px 0;color:#eee2d0}header p{margin:0;color:var(--muted);font-style:italic}
main{max-width:1180px;margin:22px auto;padding:0 14px 50px}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}
button,.button{background:#392d27;border:1px solid #765b48;color:#f3e8da;padding:9px 13px;border-radius:4px;cursor:pointer;font:inherit}
button:hover{background:#56352e}.danger{border-color:#8c3b37}.primary{background:#792d2a;border-color:#a34b43}
section{background:linear-gradient(145deg,#211e1b,#191715);border:1px solid var(--line);border-radius:7px;margin:14px 0;padding:16px;box-shadow:0 8px 25px #0004}
h2{font-size:18px;letter-spacing:1.5px;text-transform:uppercase;color:#d7b98b;border-bottom:1px solid var(--line);padding-bottom:8px;margin:0 0 14px}
h3{font-size:14px;color:#d9bda0;margin:14px 0 8px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}.field label,.small-label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
input,select,textarea{width:100%;background:#100f0e;color:var(--text);border:1px solid #5b5046;border-radius:3px;padding:9px;font:14px Georgia,serif;min-width:0}
textarea{min-height:70px;resize:vertical}input:focus,select:focus,textarea:focus{outline:1px solid var(--gold);border-color:var(--gold)}
.statbox{background:#151311;border:1px solid #51463d;padding:10px;border-radius:4px;text-align:center}.statbox strong{display:block;color:#d7b98b;font-size:11px;letter-spacing:1px}.statbox input{text-align:center;font-size:23px;font-weight:bold;border:0;background:transparent;padding:5px}
.statrow{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pillrow{display:flex;gap:10px;flex-wrap:wrap}.pill{background:#151311;border:1px solid var(--line);padding:8px 12px;border-radius:4px;flex:1;min-width:120px}.pill b{color:#d7b98b;display:block;font-size:11px;text-transform:uppercase}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{border:1px solid #51463d;padding:7px;text-align:left}th{background:#302721;color:#dfc39f;font-size:11px;text-transform:uppercase}td input,td select{padding:6px}
.skill-table td:first-child{font-weight:bold}.skill-table td:nth-child(2){color:var(--muted)}
.bar{height:8px;background:#0d0c0b;border:1px solid #51463d;border-radius:8px;overflow:hidden;margin-top:5px}.bar span{display:block;height:100%;background:var(--red);width:0}
.actions{display:flex;gap:6px;flex-wrap:wrap}.muted{color:var(--muted);font-size:12px}.note{border-left:3px solid var(--gold);padding:8px 12px;background:#171411;color:#c9bbaa;font-size:13px}
footer{text-align:center;color:#8e8174;font-size:12px;padding:18px}
@media(max-width:760px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}main{padding:0 9px 30px}section{padding:12px}.table-wrap{overflow-x:auto}.skill-table{min-width:650px}}
@media(max-width:430px){.grid,.grid.two,.grid.three{grid-template-columns:1fr 1fr}.grid .wide{grid-column:span 2}.statrow{gap:5px}.statbox{padding:6px}.statbox input{font-size:20px}}
@media print{body{background:white;color:#111;font-size:11px}header{background:white;color:#111;padding:8px;border-bottom:2px solid #333}header h1{color:#111}header p,.sig{color:#333!important}main{max-width:none;margin:0;padding:0}section{background:white;color:#111;box-shadow:none;border:1px solid #777;break-inside:avoid;padding:9px;margin:8px 0}h2,h3{color:#333}input,select,textarea{color:#111;background:white;border:0;border-bottom:1px solid #999;padding:3px}button,.toolbar,.no-print{display:none!important}th{background:#ddd;color:#111}.statbox{background:white;border-color:#777}.statbox strong{color:#111}.statbox input{color:#111}.bar{display:none}footer{color:#333}}
</style>
</head>
<body>
<header><div class="sig">Ficha de sobrevivente</div><h1>SANGUE E MEDO</h1><p>Dark Fantasy • Survival Horror • Investigação</p></header>
<main>
<div class="toolbar no-print">
<button class="primary" onclick="saveSheet()">Salvar ficha</button><button onclick="loadSheet()">Carregar salva</button><button onclick="exportSheet()">Exportar JSON</button><button onclick="document.getElementById('importFile').click()">Importar JSON</button><button onclick="window.print()">Imprimir / PDF</button><button class="danger" onclick="clearSheet()">Limpar ficha</button>
<input id="importFile" type="file" accept=".json,application/json" hidden onchange="importSheet(event)">
</div>

<section><h2>01 — Identidade</h2>
<div class="grid">
<div class="field"><label>Nome do personagem</label><input data-k="nome" placeholder="Nome completo"></div>
<div class="field"><label>Jogador</label><input data-k="jogador"></div>
<div class="field"><label>Classe</label><select data-k="classe" id="classe"><option value="">Selecione...</option><option>Guerreiro</option><option>Bárbaro</option><option>Caçador</option><option>Clérigo</option><option>Penitente</option><option>Inquisidor</option><option>Druida</option><option>Ladrão</option><option>Ocultista</option><option>Alquimista</option><option>Bardo</option><option>Bruxo</option></select></div>
<div class="field"><label>Nível (1–10)</label><input type="number" min="1" max="10" value="1" data-k="nivel" id="nivel"></div>
<div class="field"><label>Raça</label><select data-k="raca"><option value="">Selecione...</option><option>Humano</option><option>Elfo</option><option>Anão</option><option>Outra</option></select></div>
<div class="field"><label>Antecedente / Origem</label><input data-k="origem" placeholder="Ex.: Acólito Renegado"></div>
<div class="field"><label>Idade</label><input data-k="idade"></div>
<div class="field"><label>Conceito / Ocupação</label><input data-k="conceito"></div>
</div>
<div class="grid two" style="margin-top:10px"><div class="field"><label>Aparência</label><textarea data-k="aparencia"></textarea></div><div class="field"><label>Personalidade, objetivo e passado</label><textarea data-k="historia"></textarea></div></div>
</section>

<section><h2>02 — Atributos</h2><div class="note">Na criação padrão, distribua +2, +1 e 0 entre Força, Agilidade e Mente, sem repetir. A escala pode ser ampliada conforme a regra adotada na mesa.</div>
<div class="statrow" style="margin-top:12px">
<div class="statbox"><strong>FORÇA (FOR)</strong><input type="number" min="-1" max="5" value="2" data-k="for" id="for"></div>
<div class="statbox"><strong>AGILIDADE (AGI)</strong><input type="number" min="-1" max="5" value="1" data-k="agi" id="agi"></div>
<div class="statbox"><strong>MENTE (MEN)</strong><input type="number" min="-1" max="5" value="0" data-k="men" id="men"></div>
</div></section>

<section><h2>03 — Combate e sobrevivência</h2>
<div class="grid">
<div class="field"><label>Pontos de Vida atuais</label><input type="number" data-k="pvAtual" id="pvAtual" value="10"></div>
<div class="field"><label>Pontos de Vida máximos</label><input type="number" data-k="pvMax" id="pvMax" value="10"></div>
<div class="field"><label>Defesa</label><input type="number" data-k="defesa" id="defesa" value="11"></div>
<div class="field"><label>Iniciativa</label><input type="text" data-k="iniciativa" id="iniciativa" readonly></div>
<div class="field"><label>Deslocamento</label><input data-k="deslocamento" value="9 m"></div>
<div class="field"><label>Armadura equipada</label><select data-k="armadura" id="armadura"><option value="10">Traje comum / Manto (10 + AGI)</option><option value="11">Couro simples (11 + AGI)</option><option value="12">Couro batido / Gibão (12 + AGI)</option><option value="12">Camisa de malha leve (12 + AGI, máx. +1 AGI)</option><option value="13">Cota de malha completa (13)</option><option value="14">Brigantina / Loriga (14)</option><option value="15">Armadura de placas (15)</option></select></div>
<div class="field"><label>Escudo</label><select data-k="escudo"><option>Nenhum</option><option>Broquel</option><option>Escudo de madeira / ferro</option><option>Escudo torre</option></select></div>
<div class="field"><label>Arma principal</label><input data-k="arma" placeholder="Arma e dano"></div>
</div>
<h3>Recursos de sobrevivência</h3>
<div class="grid three">
<div class="field"><label>Sanidade (0–10)</label><input type="number" min="0" max="10" value="10" data-k="sanidade" id="sanidade"><div class="bar"><span id="sanBar"></span></div></div>
<div class="field"><label>Corrupção (0–10)</label><input type="number" min="0" max="10" value="0" data-k="corrupcao" id="corrupcao"><div class="bar"><span id="corBar"></span></div></div>
<div class="field"><label>Exaustão (0–6)</label><input type="number" min="0" max="6" value="0" data-k="exaustao" id="exaustao"><div class="bar"><span id="exaBar"></span></div></div>
</div>
<div class="grid two" style="margin-top:10px"><div class="field"><label>Ferimentos, condições e efeitos</label><textarea data-k="condicoes"></textarea></div><div class="field"><label>Testes de morte / observações</label><textarea data-k="morte"></textarea></div></div>
</section>

<section><h2>04 — Perícias</h2><p class="muted">Bônus automático = atributo base + treinamento. Treinamento: Não treinado +0, Treinado +2, Experiente +4, Especialista +6, Mestre +8.</p>
<div class="table-wrap"><table class="skill-table"><thead><tr><th>Perícia</th><th>Atributo</th><th>Treinamento</th><th>Bônus total</th></tr></thead><tbody id="skills"></tbody></table></div>
</section>

<section><h2>05 — Classe e habilidades</h2>
<div class="grid three">
<div class="field"><label>PV base da classe</label><input type="number" data-k="pvBase" id="pvBase" placeholder="Conforme classe"></div>
<div class="field"><label>Usos diários disponíveis</label><input type="number" data-k="usosMax" id="usosMax" value="5"></div>
<div class="field"><label>Usos diários gastos</label><input type="number" data-k="usosGastos" value="0"></div>
</div>
<div class="grid two" style="margin-top:10px"><div class="field"><label>Habilidade de classe 1</label><textarea data-k="hab1"></textarea></div><div class="field"><label>Habilidade de classe 2</label><textarea data-k="hab2"></textarea></div></div>
<div class="field" style="margin-top:10px"><label>Características adicionais / progressão</label><textarea data-k="caracteristicas"></textarea></div>
</section>

<section><h2>06 — Magia e grimório</h2>
<div class="note">Fontes: Luz (Religião), Trevas (Ocultismo) e Natureza (Natureza). Conjuração: Ação Principal; falha +1 Exaustão. Maldição: exige troca ou sacrifício; falha +1 Corrupção. Ritual: preparo de 10 minutos a 1 hora; falha −1 Sanidade.</div>
<div class="table-wrap"><table><thead><tr><th>Magia</th><th>Fonte</th><th>Execução</th><th>Perícia</th><th>CD</th><th>Efeito / custo</th><th class="no-print"> </th></tr></thead><tbody id="spells"></tbody></table></div>
<div class="actions no-print" style="margin-top:9px"><button onclick="addSpell()">+ Adicionar magia</button></div>
</section>

<section><h2>07 — Equipamentos e inventário</h2>
<div class="note">Kit básico comum: mochila, odre de água, 3 rações, pederneira, 2 tochas e 1d6 moedas de prata, além do equipamento inicial da classe.</div>
<div class="table-wrap"><table><thead><tr><th>Item / equipamento</th><th>Quantidade</th><th>Peso</th><th>Observações</th><th class="no-print"></th></tr></thead><tbody id="items"></tbody></table></div>
<div class="actions no-print" style="margin-top:9px"><button onclick="addItem()">+ Adicionar item</button></div>
<div class="grid two" style="margin-top:12px"><div class="field"><label>Moedas de prata</label><input type="number" data-k="prata" value="0"></div><div class="field"><label>Outras moedas / recursos</label><input data-k="moedasExtra"></div></div>
</section>

<section><h2>08 — Anotações</h2><div class="grid two"><div class="field"><label>Aliados, contatos e inimigos</label><textarea data-k="relacoes"></textarea></div><div class="field"><label>Diário de campanha / pistas</label><textarea data-k="anotacoes"></textarea></div></div></section>
<footer>FICHA NÃO OFICIAL • Sangue e Medo • Documento de Desenvolvimento v0.7</footer>
</main>
<script>
const skillData=[
['Atletismo','FOR'],['Briga','FOR'],['Ofícios','FOR'],['Resistência','FOR'],
['Acrobacia','AGI'],['Cavalgar','AGI'],['Furtividade','AGI'],['Pontaria','AGI'],['Prestidigitação','AGI'],['Reflexos','AGI'],
['Investigação','MEN'],['Percepção','MEN'],['Medicina','MEN'],['História','MEN'],['Religião','MEN'],['Natureza','MEN'],['Ocultismo','MEN'],['Sobrevivência','MEN'],['Intuição','MEN'],['Persuasão','MEN'],['Enganação','MEN'],['Intimidação','MEN']];
const prof={ 'Não treinado':0,'Treinado':2,'Experiente':4,'Especialista':6,'Mestre':8 };
const $=id=>document.getElementById(id);
function buildSkills(){ $('skills').innerHTML='';skillData.forEach(([name,attr],i)=>{let tr=document.createElement('tr');tr.innerHTML=`<td>${name}</td><td>${attr}</td><td><select data-skill="${i}" class="prof"><option>Não treinado</option><option>Treinado</option><option>Experiente</option><option>Especialista</option><option>Mestre</option></select></td><td><strong id="bonus${i}">0</strong></td>`;$('skills').appendChild(tr)});document.querySelectorAll('.prof').forEach(x=>x.addEventListener('change',calc));}
function calc(){let f=+($('for').value||0),a=+($('agi').value||0),m=+($('men').value||0);skillData.forEach(([n,at],i)=>{let v=at==='FOR'?f:at==='AGI'?a:m;let s=document.querySelector(`[data-skill="${i}"]`);$('bonus'+i).textContent=(v+(prof[s.value]||0)>=0?'+':'')+(v+(prof[s.value]||0));});$('iniciativa').value=(a>=0?'+':'')+a;
let base=+$('armadura').value, agi=a;if($('armadura').selectedIndex===3)agi=Math.min(agi,1);let fixed=[4,5,6,7].includes($('armadura').selectedIndex);let shield=$('escudo').value==='Escudo torre'?1:0;$('defesa').value=(fixed?base:base+agi)+shield;
['sanidade','corrupcao','exaustao'].forEach((id)=>{let max=id==='exaustao'?6:10;$(id).value=Math.max(0,Math.min(max,+$(id).value||0));let el=$(id==='sanidade'?'sanBar':id==='corrupcao'?'corBar':'exaBar');el.style.width=(+$(id).value/max*100)+'%';});
}
function addSpell(data={}){let tr=document.createElement('tr');tr.innerHTML=`<td><input placeholder="Nome" value="${esc(data.nome||'')}"></td><td><select><option>Luz</option><option>Trevas</option><option>Natureza</option></select></td><td><select><option>Conjuração</option><option>Maldição</option><option>Ritual</option></select></td><td><input placeholder="Perícia" value="${esc(data.pericia||'')}"></td><td><input type="number" placeholder="CD" value="${esc(data.cd||'')}"></td><td><input placeholder="Efeito, alcance, custo..." value="${esc(data.efeito||'')}"></td><td class="no-print"><button class="danger" onclick="this.closest('tr').remove()">×</button></td>`;$('spells').appendChild(tr);if(data.fonte)tr.children[1].querySelector('select').value=data.fonte;if(data.forma)tr.children[2].querySelector('select').value=data.forma;}
function addItem(data={}){let tr=document.createElement('tr');tr.innerHTML=`<td><input placeholder="Nome do item" value="${esc(data.nome||'')}"></td><td><input type="number" value="${esc(data.qtd??1)}"></td><td><input placeholder="Ex.: 1 kg" value="${esc(data.peso||'')}"></td><td><input placeholder="Detalhes" value="${esc(data.obs||'')}"></td><td class="no-print"><button class="danger" onclick="this.closest('tr').remove()">×</button></td>`;$('items').appendChild(tr);}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function collect(){let d={};document.querySelectorAll('[data-k]').forEach(e=>d[e.dataset.k]=e.value);d.pericias=skillData.map((s,i)=>document.querySelector(`[data-skill="${i}"]`).value);d.magias=[...$('spells').rows].map(r=>({nome:r.cells[0].querySelector('input').value,fonte:r.cells[1].querySelector('select').value,forma:r.cells[2].querySelector('select').value,pericia:r.cells[3].querySelector('input').value,cd:r.cells[4].querySelector('input').value,efeito:r.cells[5].querySelector('input').value}));d.itens=[...$('items').rows].map(r=>({nome:r.cells[0].querySelector('input').value,qtd:r.cells[1].querySelector('input').value,peso:r.cells[2].querySelector('input').value,obs:r.cells[3].querySelector('input').value}));return d;}
function apply(d){document.querySelectorAll('[data-k]').forEach(e=>{if(d[e.dataset.k]!==undefined)e.value=d[e.dataset.k]});(d.pericias||[]).forEach((v,i)=>{let e=document.querySelector(`[data-skill="${i}"]`);if(e)e.value=v});$('spells').innerHTML='';(d.magias||[]).forEach(addSpell);$('items').innerHTML='';(d.itens||[]).forEach(addItem);calc();}
function saveSheet(){localStorage.setItem('sangueemedo-ficha',JSON.stringify(collect()));alert('Ficha salva neste navegador.');}
function loadSheet(){let s=localStorage.getItem('sangueemedo-ficha');if(!s){alert('Nenhuma ficha salva neste navegador.');return}apply(JSON.parse(s));}
function exportSheet(){let blob=new Blob([JSON.stringify(collect(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ficha-sangue-e-medo.json';a.click();URL.revokeObjectURL(a.href);}
function importSheet(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{apply(JSON.parse(r.result));alert('Ficha importada.')}catch(_){alert('Arquivo JSON inválido.')}};r.readAsText(f);e.target.value='';}
function clearSheet(){if(!confirm('Apagar todos os dados desta ficha?'))return;document.querySelectorAll('[data-k]').forEach(e=>{e.value=e.type==='number'?'0':''});$('nivel').value=1;$('for').value=2;$('agi').value=1;$('men').value=0;$('pvAtual').value=10;$('pvMax').value=10;$('sanidade').value=10;$('exaustao').value=0;$('usosMax').value=5;$('spells').innerHTML='';$('items').innerHTML='';document.querySelectorAll('.prof').forEach(e=>e.value='Não treinado');calc();}
buildSkills();addSpell();addItem();document.querySelectorAll('input,select,textarea').forEach(e=>e.addEventListener('input',calc));calc();
</script>
</body></html>
